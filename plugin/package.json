{
  "name": "cairn-headlamp-plugin",
  "version": "0.1.1",
  "description": "Cairn: a Ceph storage console for Rook clusters, as a Headlamp plugin",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "headlamp-plugin build",
    "format": "headlamp-plugin format",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "package": "headlamp-plugin package",
    "tsc": "headlamp-plugin tsc",
    "test": "headlamp-plugin test",
    "i18n": "headlamp-plugin i18n",
    "icons": "node scripts/gen-icons.mjs",
    "prebuild": "node scripts/gen-icons.mjs",
    "prestart": "node scripts/gen-icons.mjs"
  },
  "keywords": [
    "headlamp",
    "headlamp-plugin",
    "kubernetes",
    "ceph",
    "rook",
    "storage",
    "cairn"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "overrides": {
    "typescript": "5.6.2"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "0.14.0",
    "@types/js-yaml": "^4.0.9"
  }
}
